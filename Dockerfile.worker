# Isolated redirect-inspection worker. Run on a network with EGRESS FILTERING (see docs/SECURITY.md).
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm i --no-save tsx@4
COPY src/lib/security ./src/lib/security
COPY worker ./worker
RUN addgroup -S w && adduser -S w -G w
USER w
ENV PORT=8787
EXPOSE 8787
CMD ["npx", "tsx", "worker/redirect-worker.ts"]
