# ---- Required ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_APP_URL=http://localhost:3000   # public base URL; https:// enables Secure cookies

# ---- Access control ----
ADMIN_EMAILS=                               # comma-separated emails that receive the admin role on register/login

# ---- Threat intelligence (all optional; missing = "configuration required" in reports) ----
WEB_RISK_API_KEY=                           # Google Web Risk (commercial use; billing account required)
URLHAUS_API_TOKEN=                          # abuse.ch Auth-Key (free; review terms for commercial use)
RDAP_BASE_URL=https://rdap.org              # RDAP bootstrap/redirector

# ---- Redirect inspection ----
REDIRECT_INSPECTION_MODE=inline             # inline | worker | disabled   (use "worker" in production)
REDIRECT_WORKER_URL=                        # e.g. http://redirect-worker:8787 when mode=worker
REDIRECT_WORKER_SECRET=                     # shared secret between app and worker

# ---- Customization ----
EXTRA_BRANDS_JSON=                          # JSON array: [{"name":"MyBank","domains":["mybank.com"]}]
EXTRA_SHORTENERS=                           # comma-separated extra shortener hostnames
ENABLE_TEST_FIXTURES=true                   # set false in production to disable the labelled synthetic fixture host

# ---- Email (password-reset delivery via Resend) – optional ----
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=ScamLens <no-reply@your-domain.example>
